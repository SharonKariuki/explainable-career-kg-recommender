# Copy this file to .env and replace the placeholder values.
# .env is gitignored. Every variable below is required unless marked optional;
# Django refuses to start and names the missing variable otherwise.

# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-string
# Optional, defaults to false
DJANGO_DEBUG=true
# Optional, comma separated, defaults to localhost,127.0.0.1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL. The user needs CREATEDB so pytest can create its test database.
DB_NAME=career_recommender
DB_USER=career_app
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=5432

# Semantic matching. Weights download on first use (Sprint 2).
SBERT_MODEL_NAME=sentence-transformers/all-mpnet-base-v2

# Minimum cosine similarity (0 to 1) for a user skill to match a graph skill.
# Starting value only; tuned during evaluation.
SIMILARITY_THRESHOLD=0.60

# Maximum number of hops the breadth-first traversal may take (integer >= 1).
MAX_TRAVERSAL_DEPTH=2

# Scoring weights (non-negative). The missing-skill weight is subtracted:
# FinalScore = WEIGHT_SKILL_COVERAGE * SkillCoverage
#            + WEIGHT_GRAPH_PROXIMITY * GraphProximity
#            - WEIGHT_MISSING_PENALTY * MissingPenalty
WEIGHT_SKILL_COVERAGE=0.5
WEIGHT_GRAPH_PROXIMITY=0.2
WEIGHT_MISSING_PENALTY=0.3
