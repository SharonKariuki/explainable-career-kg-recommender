# Copy to backend/.env and fill in real values. Never commit .env.

# Generate one with:
# python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me

DB_NAME=ajiraguide
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# OAuth 2.0 Web client id (Google Cloud Console > APIs & Services > Credentials).
# Leave blank to turn Google sign-in off. The frontend needs the same value as
# VITE_GOOGLE_CLIENT_ID in frontend/.env.
GOOGLE_CLIENT_ID=
